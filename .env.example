# Copy to .env for local use. NEVER commit real values.
NODE_ENV=development
PORT=3000
# Comma-separated exact origins allowed to open a WebSocket
ALLOWED_ORIGINS=http://localhost:3000
# Secret for keyed IP hashing (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
IP_HASH_SECRET=
# Set to 1 to refuse new sessions (maintenance / incident mode)
MAINTENANCE_MODE=0
LOG_LEVEL=info
