# Copy to .env for local use. NEVER commit real values.
# Every variable is validated at startup by src/config.ts. A bad value stops the server.
NODE_ENV=development
PORT=3000
# Comma-separated exact origins allowed to open a WebSocket (scheme://host[:port], no trailing slash).
# Must be https in production.
ALLOWED_ORIGINS=http://localhost:3000
# Number of trusted reverse proxies in front of the app (Render = 1, local = 0)
TRUST_PROXY_HOPS=0
# Optional. Secret for keyed IP hashing, 32+ characters. When empty, a random in-memory key is used.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
# Optional. 16+ characters. Send it in the "x-health-key" header to see exact numbers on /health.
HEALTH_KEY=
# Set to true to show the "preview: not launched yet" banner (keep true until public launch)
PREVIEW_BANNER=false
# Set to 1 to refuse all new connections (maintenance / incident mode)
MAINTENANCE_MODE=0
# error | warn | info | debug
LOG_LEVEL=info
# Open sockets allowed per IP address at the same time
MAX_SOCKETS_PER_IP=5
# Optional. Path to the DB-IP country database (run `npm run geo:update` to download it).
# Without it every country is unknown and "my country only" is unavailable.
COUNTRY_DB_PATH=
# How long a search sticks to shared interests before accepting anyone, in ms (500 to 60000)
INTEREST_WAIT_MS=10000
