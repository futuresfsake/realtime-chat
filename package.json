{
  "name": "realtime-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymous one-to-one chat with end-to-end encryption in the browser. A portfolio project: TypeScript, Express, Socket.IO, WebCrypto.",
  "keywords": [
    "chat",
    "websocket",
    "socket.io",
    "end-to-end-encryption",
    "webcrypto",
    "typescript",
    "privacy"
  ],
  "author": "futuresfsake",
  "license": "ISC",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node --max-old-space-size=400 dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "test:e2e": "playwright test",
    "e2e:capture": "node e2e/capture.mjs",
    "geo:update": "node scripts/fetch-geo.mjs",
    "moderation": "tsx scripts/moderation-report.ts",
    "load:test": "tsx scripts/load-test.ts",
    "build:demo": "tsx scripts/build-demo.ts",
    "demo": "tsx scripts/build-demo.ts && tsx scripts/serve-demo.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futuresfsake/realtime-chat.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/futuresfsake/realtime-chat/issues"
  },
  "homepage": "https://github.com/futuresfsake/realtime-chat#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "maxmind": "^5.1.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
